{
  "name": "data-wizard-rs",
  "private": true,
  "version": "0.1.0",
  "description": "State-of-the-art data recovery wizard for Windows \u2014 Rust + Tauri 2 + React. Root toolchain package (the frontend lives in ui/).",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm --prefix ui run dev",
    "build": "npm --prefix ui run build",
    "build:debug": "tauri build --debug",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:typecheck": "npm --prefix ui run typecheck",
    "ui:lint": "npm --prefix ui run lint",
    "ui:test:tour": "npm --prefix ui run dev -- --open false"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  }
}