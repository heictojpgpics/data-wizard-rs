{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data Wizard",
  "version": "0.1.0",
  "identifier": "io.datawizard.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "beforeBuildCommand": "npm run build --prefix ../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Data Wizard",
        "label": "main",
        "width": 1360,
        "height": 840,
        "minWidth": 1180,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#F6F8F7",
        "additionalBrowserArgs": "--enable-features=OverlayScrollbar,FluentOverlayScrollbar"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "MIT OR Apache-2.0",
    "category": "Utility",
    "shortDescription": "State-of-the-art data recovery",
    "longDescription": "Data Wizard is a free, open-source data recovery wizard for Windows, built on a Rust core with a Tauri 2 and React interface.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
